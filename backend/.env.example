APP_NAME=ai-revenue-recovery-agent
ENV=local

# For local (non-Docker) dev against the dockerized Postgres, use host port 5433
# (mapped from the container's 5432 to avoid clashing with any Postgres already
# running natively on your machine on 5432).
# When running via docker compose, DATABASE_URL is overridden to point at the
# `db` service on its internal port 5432 instead.
DATABASE_URL=postgresql+asyncpg://recovery_user:recovery_pass@localhost:5433/recovery_db
