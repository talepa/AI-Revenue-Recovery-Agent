APP_NAME=ai-revenue-recovery-agent
ENV=local

# For local (non-Docker) dev against the dockerized Postgres, use host port 5433
# (mapped from the container's 5432 to avoid clashing with any Postgres already
# running natively on your machine on 5432).
# When running via docker compose, DATABASE_URL is overridden to point at the
# `db` service on its internal port 5432 instead.
DATABASE_URL=postgresql+asyncpg://recovery_user:recovery_pass@localhost:5433/recovery_db

# Optional: without a key, diagnosis/intervention automatically use a
# deterministic rule-based fallback (see app/agents/llm_client.py) — the
# whole recovery workflow runs fine without an API key.
# Gemini is preferred when both Google and OpenAI keys are set.
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Live recovery loop: detect overdue + one LangGraph cycle per OPEN/MONITORING
# case. Off in CI (default false). Enable for a local/demo API process.
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=60

# Optional: without this, domain events are logged instead of published to
# Kafka (see app/events/) — the app runs fine without a broker. For local
# (non-Docker) dev against `docker compose up -d kafka`, use the host
# listener on 9094:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Optional: without this, locking/idempotency falls back to an in-process
# lock (see app/core/locks.py) — fine for a single process, but doesn't
# coordinate across multiple instances the way real Redis does. For local
# (non-Docker) dev against `docker compose up -d redis`, use the host
# listener on 6380:
# REDIS_URL=redis://localhost:6380/0

# Structured (JSON) logging is always on (see app/core/observability.py).
# LOG_LEVEL=INFO

# Optional: LangSmith tracing of the LangGraph workflow — off by default,
# no account required to run the app. Get a key at smith.langchain.com.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=ai-revenue-recovery-agent
